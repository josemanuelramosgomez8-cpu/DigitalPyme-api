APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_EXPIRATION=1440

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
UPLOADS_PATH=
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
SOLICITUDES_EMAIL=
FRONTEND_URL=http://localhost:8443

# Hosted card checkout via Mercado Pago. Leave empty until production credentials exist.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_ENVIRONMENT=sandbox
MERCADOPAGO_WEBHOOK_URL=
PAYMENT_RETURN_URL=http://localhost:8443

# Bank-transfer instructions shown in the store and client portal.
BANK_TRANSFER_BANK=
BANK_TRANSFER_HOLDER=
BANK_TRANSFER_ACCOUNT=
BANK_TRANSFER_CCI=

# Manual Yape/Plin payments. Store orders and project payments require proof review.
YAPE_PLIN_ENABLED=false
YAPE_PLIN_PHONE=
YAPE_PLIN_HOLDER=
YAPE_PLIN_QR_URL=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
